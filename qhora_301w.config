CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_qnap_qhora-301w=y

# 核心插件：Fanchmwrt
CONFIG_PACKAGE_luci-app-fanchmwrt=y
CONFIG_PACKAGE_luci-i18n-fanchmwrt-zh-cn=y

# 10G 网口必须的驱动
CONFIG_PACKAGE_kmod-phy-aquantia=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y

# 基础 Luci 环境
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
